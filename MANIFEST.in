# The wheel carries only the package; the sdist additionally carries everything needed
# to run the test suite from a source checkout, which is what distro packagers and
# conda-forge do. Shipping test_*.py without conftest.py and the fixtures would give
# them a suite that cannot run.
include LICENSE README.md ROADMAP.md
recursive-include tests *.py *.pptx *.md *.svg
# *.svg is tests/vrt/: the committed render snapshots test_vrt.py compares against.
# ~195 kB, and without them that suite fails rather than skips, by design.
# tools/*.py as well: tests/test_fidelity.py imports tools/fidelity.py, so an sdist
# without it ships a suite that cannot collect.
recursive-include tools *.py *.applescript *.sh

# No fonts, deliberately.  They live in the pptx2svg-fonts distribution, which builds
# from packages/pptx2svg-fonts/pyproject.toml and ships its own sdist and wheel with the
# OFL texts alongside the files they cover.  Putting 20 MB of typefaces in *this* sdist
# would undo the whole reason for splitting them out, so packages/ is excluded outright
# rather than filtered -- see pptx2svg/fonts/__init__.py.
prune packages

# Never ship build or editor droppings.
global-exclude __pycache__ *.py[cod] .DS_Store
